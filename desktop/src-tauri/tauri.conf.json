{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintVault",
  "version": "0.3.0",
  "identifier": "pl.magikh0e.printvault",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "node build.mjs && node serve.mjs",
    "beforeBuildCommand": "node build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "3D print file manager",
    "longDescription": "Indexes your 3D print folders in place, tracks print history, finds duplicates and manages filament. Nothing is uploaded.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "upgradeCode": "c70f168c-c834-5496-9dbd-3a58ce97cd70"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/magikh0e/Printery/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDRURGN0YyOTg3QTRDMEUKUldRT1RIcVk4dmZ0L0NEbFJ6dDlZYWkySFZ3UFRhVWFBSHZzQm5tV015YnRDdnBxczVMQTJ2VWIK"
    }
  }
}
